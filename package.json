{
  "name": "@vstack/openchamber",
  "version": "0.2.1",
  "description": "vstack OpenChamber panel: seven read-only views over .vstack state, including deliveries",
  "type": "module",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.24.0"
    },
    "contributes": {
      "panel": {
        "id": "vstack-workflow",
        "name": "vstack Workflow",
        "icon": "git-branch",
        "entry": "panel/index.html"
      },
      "page": {
        "id": "vstack-workflow-dashboard",
        "name": "vstack Dashboard",
        "icon": "dashboard",
        "entry": "panel/dashboard.html"
      },
      "capabilities": [
        "files"
      ]
    }
  },
  "scripts": {
    "build": "openchamber-guest-bundle panel/main.ts panel/main.js",
    "dev": "openchamber-guest-bundle panel/main.ts panel/main.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "npm pack --dry-run",
    "pack:prod": "npm pack"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.5.3",
    "@types/bun": "1.4.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0",
    "happy-dom": "^15.11.7"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vipintom/vstack-openchamber.git"
  },
  "homepage": "https://github.com/vipintom/vstack-openchamber#readme",
  "bugs": {
    "url": "https://github.com/vipintom/vstack-openchamber/issues"
  },
  "files": [
    "panel",
    "README.md",
    "NOTICE",
    "LICENSE"
  ]
}
